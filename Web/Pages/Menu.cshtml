@page
@model Web.Pages.MenuModel
@{
    ViewData["Title"] = "Menu";
}

<div class="container mt-5 mb-5">
    <h2 class="text-center mb-4">Product Catalog</h2>

    <!-- Message Display -->
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle"></i> @Model.ErrorMessage
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle"></i> @Model.SuccessMessage
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
    }

    <!-- Search Form -->
    <div class="row mb-4">
        <div class="col-md-6 offset-md-3">
            <form method="get" class="input-group">
                <input type="text" class="form-control" placeholder="Search items..." 
                       name="searchTerm" value="@Model.SearchTerm">
                <div class="input-group-append">
                    <button class="btn btn-primary" type="submit">
                        <i class="fas fa-search"></i> Search
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Shopping Cart Summary -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0">
                            <i class="fas fa-shopping-cart"></i> 
                            Cart: @(Model.CartItems.Sum(item => item.Value)) items
                        </h5>
                        <form method="post" asp-page-handler="ProceedToCheckout">
                            <button type="submit" class="btn btn-success" 
                            @(Model.CartItems.Count == 0 ? "disabled" : "")>
                                <i class="fas fa-cash-register"></i> Proceed to Checkout
                            </button>
                        </form>
                    </div>

                    @if (Model.CartItems.Count > 0)
                    {
                            <div class="table-responsive">
                                <table class="table table-sm table-borderless mb-0">
                                    <thead>
                                        <tr class="text-muted small">
                                            <th>Item</th>
                                            <th class="text-center">Quantity</th>
                                            <th class="text-right">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var cartItem in Model.CartItems)
                                    {
                                        var item = Model.Items.FirstOrDefault(i => i.Id == cartItem.Key);
                                        if (item != null)
                                        {
                                                        <tr>
                                                            <td>@item.name</td>
                                                            <td class="text-center">
                                                                <form method="post" asp-page-handler="UpdateCartQuantity" class="d-flex align-items-center justify-content-center">
                                                                    <input type="hidden" name="itemId" value="@item.Id">
                                                                    <input type="number" name="newQuantity" value="@cartItem.Value" 
                                                                           min="1" max="@item.stock" 
                                                                           class="form-control form-control-sm text-center" 
                                                                           style="width: 60px;">
                                                                    <button type="submit" class="btn btn-sm btn-outline-secondary ml-2" 
                                                                            title="Update quantity">
                                                                        <i class="fas fa-sync-alt"></i>
                                                                    </button>
                                                                </form>
                                                            </td>
                                                            <td class="text-right">
                                                                <form method="post" asp-page-handler="RemoveFromCart">
                                                                    <input type="hidden" name="itemId" value="@item.Id">
                                                                    <button type="submit" class="btn btn-sm btn-danger">
                                                                        <i class="fas fa-trash-alt"></i> Remove
                                                                    </button>
                                                                </form>
                                                            </td>
                                                        </tr>
                                        }
                                    }
                                    </tbody>
                                </table>
                            </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (Model.Items.Count == 0)
    {
            <div class="alert alert-info">
                No items found. Please try another search or browse our full catalog.
            </div>
    }
    else
    {
            <!-- Items Grid -->
            <div class="row">
            @foreach (var item in Model.Items)
            {
                        <div class="col-md-4 col-sm-6 mb-4">
                            <div class="card h-100">
                        @if (!string.IsNullOrEmpty(item.image_path))
                        {
                                        <img src="@item.image_path" class="card-img-top" alt="@item.name" style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                                        <img src="/images/placeholder.jpg" class="card-img-top" alt="No image available" style="height: 200px; object-fit: cover;">
                        }
                                <div class="card-body">
                                    <h5 class="card-title">@item.name</h5>
                                    <p class="card-text">
                                        <strong>Price:</strong> $@item.price.ToString("0.00")<br>
                                        <strong>In Stock:</strong> @item.stock
                                    </p>

                            @{
                                int currentInCart = Model.CartItems.ContainsKey(item.Id) ? Model.CartItems[item.Id] : 0;
                                int remainingStock = item.stock - currentInCart;
                            }

                            @if (item.stock > 0)
                            {
                                            <form method="post" asp-page-handler="AddToCart">
                                                <input type="hidden" name="itemId" value="@item.Id">
                                                <div class="form-row align-items-center">
                                                    <div class="col-auto">
                                                        <div class="input-group mb-2">
                                                            <div class="input-group-prepend">
                                                                <span class="input-group-text">Quantity</span>
                                                            </div>
                                                            <input type="number" class="form-control" name="quantity" 
                                                                   value="1" min="1" max="@remainingStock" style="width: 70px;">
                                                        </div>
                                                    </div>
                                                    <div class="col">
                                                        <button type="submit" class="btn btn-primary mb-2 w-100" 
                                            @(remainingStock <= 0 ? "disabled" : "")>
                                                            <i class="fas fa-cart-plus"></i> Add to Cart
                                                        </button>
                                                    </div>
                                                </div>
                                            </form>

                                @if (currentInCart > 0)
                                {
                                                    <div class="alert alert-success mt-2 mb-0 py-2">
                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <span>
                                                                <strong>@currentInCart</strong> in cart
                                                @if (remainingStock <= 0)
                                                {
                                                                        <small class="d-block text-danger">Max stock reached</small>
                                                }
                                                else
                                                {
                                                                        <small class="d-block">(@remainingStock more available)</small>
                                                }
                                                            </span>
                                                            <form method="post" asp-page-handler="RemoveFromCart" class="ml-2">
                                                                <input type="hidden" name="itemId" value="@item.Id">
                                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                                    <i class="fas fa-times"></i>
                                                                </button>
                                                            </form>
                                                        </div>
                                                    </div>
                                }
                            }
                            else
                            {
                                            <div class="alert alert-secondary mb-0">
                                                <i class="fas fa-exclamation-triangle"></i> Out of stock
                                            </div>
                            }
                                </div>
                            </div>
                        </div>
            }
            </div>
    }
</div>

@section Scripts {
        <script>
            // Enable Bootstrap tooltips
            $(function () {
                $('[data-toggle="tooltip"]').tooltip();
            });
        </script>
}